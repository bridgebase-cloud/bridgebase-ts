{
  "name": "@bridgebase/core",
  "version": "0.2.0",
  "description": "BridgeBase Core - Shared session management, gateway resolution, and proxy lifecycle",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "bridgebase",
    "gateway",
    "proxy",
    "session-management",
    "database"
  ],
  "author": "BridgeBase Team",
  "license": "MIT",
  "homepage": "https://github.com/bridgebase-cloud/bridgebase-ts/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/bridgebase-cloud/bridgebase-ts/issues"
  },"repository": {
    "type": "git",
    "url": "https://github.com/bridgebase-cloud/bridgebase-ts",
    "directory": "packages/core"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "async-lock": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "tsup": "^8.0.0"
  }
}
