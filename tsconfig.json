{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@bridgebase/core": ["packages/core/src"],
      "@bridgebase/redis": ["packages/redis/src"],
      "@bridgebase/tigerbeetle": ["packages/tigerbeetle/src"]
    }
  },
  "exclude": ["node_modules", "dist", "packages/*/dist", "examples", "tests"]
}
